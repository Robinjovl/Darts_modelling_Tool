{
  "plugin_registry": {
    "entries": [
      {
        "type_id": "pc/ModelProperties@v1",
        "kind": "pc",
        "constructor": "model.py:ModelProperties",
        "config_model": "darts.api.type_registry:PropertyContainerConfig",
        "customizable": true,
        "doc": "3ph_comp_w ModelProperties property container"
      },
      {
        "type_id": "flash/ConstantKReduced@v1",
        "kind": "flash",
        "constructor": "darts.physics.properties.flash:ConstantK",
        "customizable": true,
        "doc": "Constant-K flash for non-water components"
      },
      {
        "type_id": "density/DensityBrineCO2@v1",
        "kind": "density",
        "constructor": "darts.physics.properties.density:DensityBrineCO2",
        "customizable": true,
        "doc": "Brine density with dissolved CO2 correction"
      }
    ]
  },
  "reservoir": {
    "type": "structured",
    "nx": 1000,
    "ny": 1,
    "nz": 1,
    "dx": 1,
    "dy": 10,
    "dz": 10,
    "permx": 100,
    "permy": 100,
    "permz": 10,
    "poro": 0.3,
    "depth": 1000
  },
  "physics": {
    "plugin": {
      "type_id": "physics/Compositional@v1",
      "config": {
        "state_spec": "P",
        "n_points": 200,
        "min_p": 1,
        "max_p": 300,
        "min_z": 0.0,
        "max_z": 1.0,
        "epsilon_z": 1e-09
      }
    },
    "components": [
      "CO2",
      "C1",
      "H2S",
      "H2O"
    ],
    "phases": [
      "gas",
      "oil",
      "wat"
    ],
    "property_regions": [
      {
        "region": 0,
        "property_container": {
          "type_id": "pc/ModelProperties@v1",
          "config": {
            "components_name": [
              "CO2",
              "C1",
              "H2S",
              "H2O"
            ],
            "phases_name": [
              "gas",
              "oil",
              "wat"
            ],
            "Mw": [
              44.01,
              16.04,
              34.081,
              18.015
            ],
            "eps_z": 1e-09,
            "rock_comp": 1e-06,
            "temperature": 1.0
          }
        },
        "plugins": {
          "flash_ev": {
            "type_id": "flash/ConstantKReduced@v1",
            "config": {
              "nc": 3,
              "ki": [
                4.0,
                2.0,
                0.01
              ],
              "eps": 1e-08
            }
          },
          "density_ev": {
            "gas": {
              "type_id": "density/DensityBasic@v1",
              "config": {
                "compr": 0.001,
                "dens0": 200
              }
            },
            "oil": {
              "type_id": "density/DensityBasic@v1",
              "config": {
                "compr": 1e-05,
                "dens0": 600
              }
            },
            "wat": {
              "type_id": "density/DensityBrineCO2@v1",
              "config": {
                "components": [
                  "CO2",
                  "C1",
                  "H2S",
                  "H2O"
                ],
                "compr": 1e-05,
                "dens0": 1000,
                "co2_mult": 0
              }
            }
          },
          "viscosity_ev": {
            "gas": {
              "type_id": "viscosity/ConstFunc@v1",
              "config": {
                "value": 0.05
              }
            },
            "oil": {
              "type_id": "viscosity/ConstFunc@v1",
              "config": {
                "value": 0.5
              }
            },
            "wat": {
              "type_id": "viscosity/ConstFunc@v1",
              "config": {"$preset": "evaluators/viscosity/water_constant"}
            }
          },
          "rel_perm_ev": {
            "gas": {
              "type_id": "relperm/PhaseRelPerm@v1",
              "config": {"$preset": "evaluators/rel_perm/quadratic_gas"}
            },
            "oil": {
              "type_id": "relperm/PhaseRelPerm@v1",
              "config": {
                "phase": "oil"
              }
            },
            "wat": {
              "type_id": "relperm/PhaseRelPerm@v1",
              "config": {
                "phase": "wat"
              }
            }
          }
        }
      }
    ]
  },
  "wells": {
    "wells": [
      {
        "name": "I1",
        "perforations": [
          {
            "ijk": [
              1,
              1,
              1
            ]
          }
        ],
        "controls": {
          "inj_rate": 20.0,
          "rate_type": "MOLAR_RATE",
          "phase_name": "gas",
          "inj_composition": [
            0.99999998,
            1e-08,
            1e-08
          ]
        }
      },
      {
        "name": "P1",
        "perforations": [
          {
            "ijk": [
              1000,
              1,
              1
            ]
          }
        ],
        "controls": {
          "prod_bhp": 50.0
        }
      }
    ]
  },
  "initial_conditions": {
    "by_array": {
      "pressure": 50.0,
      "CO2": 0.1,
      "C1": 0.2,
      "H2S": 0.59999999
    }
  },
  "sim_params": {
    "first_ts": 0.001,
    "mult_ts": 2.0,
    "max_ts": 1.0,
    "runtime": 100,
    "tol_newton": 0.01,
    "tol_linear": 0.001,
    "it_newton": 10,
    "it_linear": 50,
    "newton_type": "newton_local_chop"
  },
  "output": {
    "folder": "output",
    "precision": "d"
  }
}
