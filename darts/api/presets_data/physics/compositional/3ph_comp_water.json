{
  "_meta": {
    "name": "3ph_comp_water",
    "description": "3-phase compositional CO2-C1-H2S with immiscible water phase, on a 200-point P-only OBL grid (1-300 bar). Self-contained: ships its custom ModelProperties property container with a K-value flash on hydrocarbons + immiscible water under presets_data/code/, plus the full evaluator stack (DensityBasic + DensityBrineCO2 + ConstFunc viscosity + PhaseRelPerm + ConstantKReduced flash). Parity preset for the legacy 3ph_comp_w model template.",
    "references": [],
    "tags": ["physics", "compositional", "3ph", "co2", "c1", "h2s", "water", "isothermal"],
    "version": "1"
  },
  "config": {
    "state_spec": "P",
    "n_points": 200,
    "min_p": 1,
    "max_p": 300,
    "min_z": 0.0,
    "max_z": 1.0,
    "epsilon_z": 1e-09,
    "components": ["CO2", "C1", "H2S", "H2O"],
    "phases": ["gas", "oil", "wat"]
  },
  "property_regions": [
    {
      "region": 0,
      "property_container": {
        "type_id": "pc/Comp3phWaterProperties@v1",
        "config": {
          "components_name": ["CO2", "C1", "H2S", "H2O"],
          "phases_name": ["gas", "oil", "wat"],
          "Mw": [44.01, 16.04, 34.08, 18.015],
          "eps_z": 1e-09
        }
      },
      "plugins": {
        "flash_ev": {"type_id": "flash/ConstantKReduced@v1", "config": {"nc": 3, "ki": [4.0, 2.0, 0.01], "eps": 1e-08}},
        "density_ev": {
          "gas": {"type_id": "density/DensityBasic@v1",     "config": {"compr": 0.001,  "dens0": 200}},
          "oil": {"type_id": "density/DensityBasic@v1",     "config": {"compr": 1e-05,  "dens0": 600}},
          "wat": {"type_id": "density/DensityBrineCO2@v1",  "config": {"components": ["CO2", "C1", "H2S", "H2O"], "compr": 1e-05, "dens0": 1000, "co2_mult": 0}}
        },
        "viscosity_ev": {
          "gas": {"type_id": "viscosity/ConstFunc@v1", "config": {"value": 0.05}},
          "oil": {"type_id": "viscosity/ConstFunc@v1", "config": {"value": 0.5}},
          "wat": {"type_id": "viscosity/ConstFunc@v1", "config": {"value": 0.5}}
        },
        "rel_perm_ev": {
          "gas": {"type_id": "relperm/PhaseRelPerm@v1", "config": {"phase": "gas"}},
          "oil": {"type_id": "relperm/PhaseRelPerm@v1", "config": {"phase": "oil"}},
          "wat": {"type_id": "relperm/PhaseRelPerm@v1", "config": {"phase": "wat"}}
        }
      }
    }
  ],
  "plugin_registry": {
    "entries": [
      {
        "type_id": "pc/Comp3phWaterProperties@v1",
        "kind": "pc",
        "constructor": "../../code/comp_3ph_water_model_properties.py:ModelProperties",
        "config_model": "darts.api.type_registry:PropertyContainerConfig",
        "customizable": true,
        "doc": "3ph_comp_w compositional w/ immiscible water property container (bundled)"
      },
      {
        "type_id": "flash/ConstantKReduced@v1",
        "kind": "flash",
        "constructor": "darts.physics.properties.flash:ConstantK",
        "customizable": true,
        "doc": "Constant-K flash for non-water components"
      },
      {
        "type_id": "density/DensityBrineCO2@v1",
        "kind": "density",
        "constructor": "darts.physics.properties.density:DensityBrineCO2",
        "customizable": true,
        "doc": "Brine density with dissolved CO2 correction"
      }
    ]
  }
}
