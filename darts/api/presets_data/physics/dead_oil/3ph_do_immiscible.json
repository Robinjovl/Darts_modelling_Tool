{
  "_meta": {
    "name": "3ph_do_immiscible",
    "description": "Immiscible 3-phase dead-oil gas-oil-water physics on a 100-point P-only OBL grid (1-200 bar). Self-contained: ships its custom ModelProperties property container with a trivial diagonal flash under presets_data/code/, plus the full evaluator stack (DensityBasic for gas/oil, DensityBrineCO2 for water, ConstFunc viscosities, PhaseRelPerm). Parity preset for the legacy 3ph_do model template.",
    "references": [],
    "tags": ["physics", "dead-oil", "3ph", "immiscible", "gas-oil-water", "isothermal"],
    "version": "1"
  },
  "config": {
    "state_spec": "P",
    "n_points": 100,
    "min_p": 1,
    "max_p": 200,
    "min_z": 0.0,
    "max_z": 1.0,
    "epsilon_z": 1e-09,
    "components": ["g", "o", "w"],
    "phases": ["gas", "oil", "wat"]
  },
  "property_regions": [
    {
      "region": 0,
      "property_container": {
        "type_id": "pc/DeadOil3phImmiscibleProperties@v1",
        "config": {
          "components_name": ["g", "o", "w"],
          "phases_name": ["gas", "oil", "wat"],
          "Mw": [1.0, 1.0, 1.0],
          "eps_z": 1e-09,
          "rock_comp": 1e-06
        }
      },
      "plugins": {
        "density_ev": {
          "gas": {"type_id": "density/DensityBasic@v1",     "config": {"compr": 0.001,  "dens0": 200}},
          "oil": {"type_id": "density/DensityBasic@v1",     "config": {"compr": 1e-05,  "dens0": 600}},
          "wat": {"type_id": "density/DensityBrineCO2@v1",  "config": {"components": ["g", "o", "w"], "compr": 1e-05, "dens0": 1000, "co2_mult": 0}}
        },
        "viscosity_ev": {
          "gas": {"type_id": "viscosity/ConstFunc@v1", "config": {"value": 0.05}},
          "oil": {"type_id": "viscosity/ConstFunc@v1", "config": {"value": 0.5}},
          "wat": {"type_id": "viscosity/ConstFunc@v1", "config": {"value": 0.5}}
        },
        "rel_perm_ev": {
          "gas": {"type_id": "relperm/PhaseRelPerm@v1", "config": {"phase": "gas"}},
          "oil": {"type_id": "relperm/PhaseRelPerm@v1", "config": {"phase": "oil"}},
          "wat": {"type_id": "relperm/PhaseRelPerm@v1", "config": {"phase": "wat"}}
        }
      }
    }
  ],
  "plugin_registry": {
    "entries": [
      {
        "type_id": "pc/DeadOil3phImmiscibleProperties@v1",
        "kind": "pc",
        "constructor": "../../code/dead_oil_3ph_model_properties.py:ModelProperties",
        "config_model": "darts.api.type_registry:PropertyContainerConfig",
        "customizable": true,
        "doc": "3ph_do immiscible gas-oil-water property container (bundled)"
      },
      {
        "type_id": "density/DensityBrineCO2@v1",
        "kind": "density",
        "constructor": "darts.physics.properties.density:DensityBrineCO2",
        "customizable": true,
        "doc": "Brine density with dissolved CO2 correction"
      }
    ]
  }
}
