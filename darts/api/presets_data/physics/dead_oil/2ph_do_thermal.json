{
  "_meta": {
    "name": "2ph_do_thermal",
    "description": "Thermal 2-phase dead-oil water-oil physics on a 400-point P/T OBL grid (0-1000 bar, 273-473 K). Self-contained: ships its custom ModelProperties property container under presets_data/code/, plus the full evaluator stack (DensityBasic + ConstFunc viscosity + EnthalpyBasic + ConstFunc conductivity + PhaseRelPerm). Parity preset for the legacy 2ph_do_thermal model template.",
    "references": [],
    "tags": ["physics", "dead-oil", "2ph", "thermal", "water-oil"],
    "version": "1"
  },
  "config": {
    "state_spec": "PT",
    "n_points": 400,
    "min_p": 0,
    "max_p": 1000,
    "min_t": 273.15,
    "max_t": 473.15,
    "min_z": 0.0,
    "max_z": 1.0,
    "epsilon_z": 1e-14,
    "components": ["w", "o"],
    "phases": ["wat", "oil"]
  },
  "property_regions": [
    {
      "region": 0,
      "property_container": {
        "type_id": "pc/DeadOil2phThermalProperties@v1",
        "config": {
          "components_name": ["w", "o"],
          "phases_name": ["wat", "oil"],
          "eps_z": 1e-14
        }
      },
      "plugins": {
        "density_ev": {
          "wat": {"type_id": "density/DensityBasic@v1", "config": {"compr": 1e-05, "dens0": 1014}},
          "oil": {"type_id": "density/DensityBasic@v1", "config": {"compr": 0.005,  "dens0": 50}}
        },
        "viscosity_ev": {
          "wat": {"type_id": "viscosity/ConstFunc@v1", "config": {"value": 0.3}},
          "oil": {"type_id": "viscosity/ConstFunc@v1", "config": {"value": 0.03}}
        },
        "enthalpy_ev": {
          "wat": {"type_id": "enthalpy/EnthalpyBasic@v1", "config": {"hcap": 4.18}},
          "oil": {"type_id": "enthalpy/EnthalpyBasic@v1", "config": {"hcap": 0.035}}
        },
        "conductivity_ev": {
          "wat": {"type_id": "conductivity/ConstFunc@v1", "config": {"value": 1.0}},
          "oil": {"type_id": "conductivity/ConstFunc@v1", "config": {"value": 1.0}}
        },
        "rel_perm_ev": {
          "wat": {"type_id": "relperm/PhaseRelPerm@v1", "config": {"phase": "gas", "swc": 0.1, "sgr": 0.1}},
          "oil": {"type_id": "relperm/PhaseRelPerm@v1", "config": {"phase": "oil", "swc": 0.1, "sgr": 0.1}}
        }
      }
    }
  ],
  "plugin_registry": {
    "entries": [
      {
        "type_id": "pc/DeadOil2phThermalProperties@v1",
        "kind": "pc",
        "constructor": "../../code/dead_oil_thermal_model_properties.py:ModelProperties",
        "config_model": "darts.api.type_registry:PropertyContainerConfig",
        "customizable": true,
        "doc": "2ph_do_thermal water-oil property container (bundled)"
      }
    ]
  }
}
