{
  "_meta": {
    "name": "cpg_deadoil_brugge",
    "description": "Brugge-style two-phase water-oil dead-oil physics for a CPG reservoir. Ships its own property-container plugin via the preset plugin_registry block so this preset is self-contained — no model_type template fallback needed.",
    "references": [
      "Peters, L. et al. (2009). Results of the Brugge Benchmark Study for Flooding Optimisation and History Matching. SPE Reservoir Evaluation & Engineering."
    ],
    "tags": ["physics", "dead-oil", "two-phase", "cpg", "brugge"],
    "version": "1"
  },
  "config": {
    "state_spec": "P",
    "n_points": 400,
    "min_p": 0.0,
    "max_p": 1000.0,
    "min_z": 0.0,
    "max_z": 1.0,
    "epsilon_z": 1e-14,
    "components": ["w", "o"],
    "phases": ["wat", "oil"]
  },
  "property_regions": [
    {
      "region": 0,
      "property_container": {
        "type_id": "pc/ModelProperties@v1",
        "config": {
          "components_name": ["w", "o"],
          "phases_name": ["wat", "oil"],
          "eps_z": 1e-14
        }
      },
      "plugins": {
        "density_ev": {
          "wat": {
            "type_id": "density/DensityBasic@v1",
            "config": {"compr": 1e-05, "dens0": 1014}
          },
          "oil": {
            "type_id": "density/DensityBasic@v1",
            "config": {"compr": 0.005, "dens0": 500}
          }
        },
        "viscosity_ev": {
          "wat": {
            "type_id": "viscosity/ConstFunc@v1",
            "config": {"value": 0.3}
          },
          "oil": {
            "type_id": "viscosity/ConstFunc@v1",
            "config": {"value": 0.03}
          }
        },
        "rel_perm_ev": {
          "wat": {
            "type_id": "relperm/PhaseRelPerm@v1",
            "config": {"phase": "wat", "swc": 0.1, "sgr": 0.1}
          },
          "oil": {
            "type_id": "relperm/PhaseRelPerm@v1",
            "config": {"phase": "oil", "swc": 0.1, "sgr": 0.1}
          }
        }
      }
    }
  ],
  "plugin_registry": {
    "entries": [
      {
        "type_id": "pc/ModelProperties@v1",
        "kind": "pc",
        "constructor": "../../code/dead_oil_model_properties.py:ModelProperties",
        "config_model": "darts.api.type_registry:PropertyContainerConfig",
        "customizable": true,
        "doc": "Bundled dead-oil ModelProperties property container (synced from models/2ph_do/model.py)"
      }
    ]
  }
}
