[submodule "thirdparty/MshIO"]
	path = thirdparty/MshIO
	url = https://gitlab.com/open-darts/MshIO-fork

[submodule "thirdparty/pybind11"]
	path = thirdparty/pybind11
	url = https://github.com/pybind/pybind11
    branch = master

[submodule "thirdparty/hypre"]
	path = thirdparty/hypre
	url = https://github.com/hypre-space/hypre.git
	# The HYPRE build writes its CMake build tree into thirdparty/hypre/src/cmbuild
	# (an untracked dir HYPRE's own .gitignore does not cover), which otherwise
	# makes `git status` report the submodule dirty after every build. Ignore
	# work-tree changes here; pinned-commit (gitlink) changes are still reported.
	ignore = dirty

[submodule "thirdparty/iphreeqc"]
	path = thirdparty/iphreeqc
	url = https://github.com/usgs-coupled/iphreeqc.git
	branch = master
[submodule "thirdparty/AMGX"]
	path = thirdparty/AMGX
	url = https://github.com/NVIDIA/AMGX.git
