Bootstrap: docker
From:      nvidia/cuda:12.8.1-devel-rockylinux8

%labels
    PROJECT     open-darts

%arguments
    GITLAB_CI_TOOLS=0

%environment
    source /opt/rh/gcc-toolset-13/enable
    source /opt/conda/etc/profile.d/conda.sh
    export GSELINSOLVERSPATH=/opt/darts-linear-solvers/build

%post
    # exiting pipeline with a non-zero exit code if any command in a pipeline fails
    set -euo pipefail

    # install base packages
    dnf -y clean all
    dnf -y upgrade
    dnf -y install epel-release dnf-plugins-core
    dnf -y install --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
        jq patchelf wget git ca-certificates which tar xz bzip2 make cmake \
        python3 python3-pip libjpeg-turbo-devel \
        gcc-toolset-13-gcc-c++
    echo 'source /opt/rh/gcc-toolset-13/enable' >> /etc/profile.d/gcc13.sh

    # miniconda installation
    CONDA_DIR=/opt/conda
    curl -fsSL https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -o /tmp/miniconda.sh
    bash /tmp/miniconda.sh -b -p $CONDA_DIR
    rm -f /tmp/miniconda.sh
    source /opt/conda/bin/activate
    $CONDA_DIR/bin/conda init --all
    conda clean -a -y
    # accept Anaconda Terms of Service
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r
    
    # cleanup & size reduction 
    dnf -y remove gmp-devel mpfr-devel libmpc-devel isl-devel zlib-devel || true
    dnf -y autoremove
    dnf clean all

    # capture actual GCC version, build date and CUDA version
    source /opt/rh/gcc-toolset-13/enable
    GCC_VERSION="$(gcc -dumpfullversion 2>/dev/null || gcc -dumpversion || echo unknown)"
    BUILD_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    CUDA_VERSION="$(nvcc --version | awk -F',| ' '/release/{print $6}')"
    # inject into labels.json - %labels section
    LBL=/.singularity.d/labels.json
    TMP=$(mktemp)
    jq --arg gv "$GCC_VERSION" --arg bd "$BUILD_DATE" --arg cv "$CUDA_VERSION" \
    '.GCC=$gv | .BUILT_AT=$bd | .CUDA=$cv' \
    "$LBL" > "$TMP" && mv "$TMP" "$LBL"

    # install darts-linear-solvers
    # Expect CI to pass:
    #   DLS_TOKEN  – read-only personal/deploy token (protected variable)
    DLS_URL="https://oauth2:{{DLS_TOKEN}}@gitlab.tudelft.nl/dvoskov/darts-linear-solvers.git"
    mkdir -p /opt
    git clone "${DLS_URL}" /opt/darts-linear-solvers
    cd /opt/darts-linear-solvers
    export CUDA_ARCH={{CUDA_ARCH}}
    ./helper_scripts/build_gpu.sh

    # Standardize library/include layout for consumers
    mkdir -p build/lib build/include
    mv *.a ./lib/AMGX/build/*.so ./build/lib/
    cp -r ./include/* ./lib/bos_linear_solver_lib/include/* ./build/include/ || true

    # Ensure path is exported at runtime
    export GSELINSOLVERSPATH=/opt/darts-linear-solvers/build >> /environment

    # GitLab CI tools
    if [ {{GITLAB_CI_TOOLS}} ]; then
        conda create -n ci_cd python={{PY_VER}} --yes
        eval "$(conda shell.bash hook)"
        conda activate ci_cd
        conda install datasets debugpy
        conda install -c conda-forge git python-gitlab --yes

        curl -fsSL https://rpm.nodesource.com/setup_current.x | bash
        dnf install nodejs -y
        npm install -g @openai/codex@native
    fi

%runscript
    exec /bin/bash "$@"
